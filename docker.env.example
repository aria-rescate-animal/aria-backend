# ARIA Docker - entorno local con Docker Compose
# Copia este archivo como docker.env y reemplaza los valores placeholder.
# No subas docker.env al repositorio.

NODE_ENV=development

# Ruta al repositorio frontend desde la carpeta del backend.
# Si clonaste ambos repositorios en la misma carpeta padre:
# aria-backend/
# aria-frontend/
# deja este valor como ../aria-frontend
ARIA_FRONTEND_PATH=../aria-frontend

# URLs locales expuestas por Docker
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# MySQL dentro de Docker
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=3000

# Seguridad
JWT_SECRET=change_me_jwt_secret
SESSION_SECRET=change_me_session_secret

# IA Service
GEMINI_API_KEY=change_me_gemini_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=change_me_cloud_name
CLOUDINARY_API_KEY=change_me_cloudinary_api_key
CLOUDINARY_API_SECRET=change_me_cloudinary_api_secret

# Resend
RESEND_API_KEY=change_me_resend_api_key
RESEND_FROM=aria@ariaproyecto.online

# Google OAuth
GOOGLE_CLIENT_ID=change_me_google_client_id
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
